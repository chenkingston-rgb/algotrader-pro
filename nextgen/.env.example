# Configure these as GitHub Actions secrets or variables. Never commit values.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_SIGNAL_FEED=sip_delayed
ALPACA_QUOTE_FEED=iex
EXPECTED_ALPACA_ACCOUNT_ID=

# Cloudflare Worker/D1 durable state. Mandatory in live mode.
STATE_API_URL=https://YOUR-WORKER.workers.dev
STATE_API_WRITE_TOKEN=

# Ephemeral local diagnostics only on a GitHub runner.
STATE_DB=/tmp/trend3-qqq20/state.sqlite3
STATUS_PATH=/tmp/trend3-qqq20/dashboard.json

INITIAL_PEAK_EQUITY=
CUMULATIVE_EXTERNAL_CASH_FLOW=0
STRATEGY_ALLOCATION=0.10
ALERT_WEBHOOK_URL=
HEARTBEAT_URL=https://YOUR-WORKER.workers.dev/v1/heartbeat/YOUR_HEARTBEAT_SECRET
CONFIRM_LIVE=
CONFIRM_SCALE=
LIVE_AUTHORIZED_UNTIL=
